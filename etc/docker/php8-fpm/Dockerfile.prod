# Production PHP-FPM image for Superdesk Web Publisher.
#
# Build context is the REPOSITORY ROOT (not etc/docker/php8-fpm) so the
# application source can be baked in:
#
#   docker build -f etc/docker/php8-fpm/Dockerfile.prod -t <image> .
#
# Differences from the dev image (php8-fpm/Dockerfile): the application code and
# production Composer dependencies are baked in (no runtime bind mount), xdebug
# and display_errors are gone, opcache is tuned for immutable code, and the PHP
# upload limits match Superdesk's media push size.
FROM php:8.0-fpm-alpine

# Runtime + build extensions. Mirrors the dev image minus xdebug and the
# interactive editors; keep this list in sync with the supervisor prod image,
# which boots the same Symfony kernel.
RUN set -ex \
    && apk --no-cache add \
        postgresql-dev zlib-dev libxml2-dev curl-dev \
        freetype libpng libjpeg-turbo \
        freetype-dev libpng-dev libjpeg-turbo-dev \
        libintl icu icu-dev git \
        libmemcached-dev autoconf build-base \
        rabbitmq-c-dev libzip-dev zip oniguruma-dev libwebp-dev \
        curl jq \
    && docker-php-ext-configure intl \
    && docker-php-ext-install intl \
    && docker-php-ext-configure pgsql -with-pgsql=/usr/local/pgsql \
    && docker-php-ext-install pdo pdo_pgsql pgsql opcache sockets exif bcmath \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install zip xml gd mbstring curl \
    && pecl install memcached && docker-php-ext-enable memcached \
    # Pin php-amqp to the last 1.x. php-amqp 2.x changed AMQPQueue::ack()/nack() to
    # return void, but symfony/amqp-messenger 5.4 declares ack(): bool and returns
    # that value directly (Transport/Connection.php), so on 2.x messenger:consume
    # dies with "ack(): Return value must be of type bool, null returned" (exit 255)
    # right after handling each message — the async content_push consumer crash-loops
    # and no swp_article rows are ever committed. 1.11.0 returns bool. (Publishing is
    # unaffected, which is why the push endpoint worked on 2.x.)
    && pecl install amqp-1.11.0 && docker-php-ext-enable amqp

# Production PHP settings: errors to the log (never the response), opcache with
# timestamp validation off (code is immutable in the image), and upload limits
# for Superdesk's /api/v2/assets/push.
RUN { \
      echo 'display_errors=Off'; \
      echo 'log_errors=On'; \
      echo 'error_reporting=E_ALL & ~E_DEPRECATED & ~E_NOTICE'; \
      echo 'date.timezone=Africa/Nairobi'; \
      echo 'upload_max_filesize=100M'; \
      echo 'post_max_size=100M'; \
      echo 'memory_limit=256M'; \
      echo 'opcache.enable=1'; \
      echo 'opcache.validate_timestamps=0'; \
      echo 'opcache.max_accelerated_files=20000'; \
      echo 'opcache.memory_consumption=256'; \
    } > /usr/local/etc/php/conf.d/zz-production.ini

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
ENV COMPOSER_ALLOW_SUPERUSER=1 COMPOSER_NO_INTERACTION=1 APP_ENV=prod APP_DEBUG=0

WORKDIR /var/www/publisher
COPY . /var/www/publisher

# Install locked, no-dev, authoritative-classmap dependencies. Skip Symfony's
# auto-scripts (they need runtime secrets we do not bake), but warm the prod
# cache at build so the first request does not pay the container-compile cost
# (which can exceed the ALB health-check timeout). cache:warmup compiles the DI
# container with .env defaults; env values stay runtime placeholders, so the
# warmed cache is safe to bake. var/ must be writable by the FPM worker.
RUN composer install --no-dev --classmap-authoritative --no-scripts --prefer-dist --no-progress \
    && php bin/console cache:warmup --env=prod --no-debug \
    && composer clear-cache \
    && mkdir -p var/cache var/log \
    && chown -R www-data:www-data var

# Bake the default tenant's theme TEMPLATES into its runtime theme dir so php-fpm
# can render them. The sylius theme loader resolves a tenant's theme by scanning
# %kernel.project_dir%/app/themes/<tenantCode>/<themeName> on the LOCAL filesystem
# (see TenantableConfigurationSourceFactory default `app/themes`); tenant.theme_name
# lives in shared Postgres, but the theme FILES do not. `swp:theme:install` (run by
# the publisher-bootstrap RunTask one-shot) writes those files to the throwaway job
# container's disk, never to these long-running publisher-web containers, so without
# this bake the tenant has theme_name='swp/default-theme' but no templates and the
# site renders nothing. Baking makes every replica self-contained and deterministic.
#
# Tenant code 123abc and the generatedData strip mirror bootstrap-publisher.sh's bare
# install (generatedData only drives the install-time routes/menus/articles processor,
# which bootstrap does via SQL; it is inert at render time, but we drop it to match).
# NOTE: 123abc is the fixed default-tenant code from bootstrap-publisher.sh; if that
# changes, change it here too. This bakes templates only — theme ASSETS (styling under
# public/_themes) are served as static files by the separate nginx image and are a
# distinct, pre-existing gap (bootstrap's assets:install never reaches nginx either).
RUN set -eux; \
    src=src/SWP/Bundle/FixturesBundle/Resources/themes/DefaultTheme; \
    dest=app/themes/123abc/DefaultTheme; \
    mkdir -p "$(dirname "$dest")"; \
    cp -r "$src" "$dest"; \
    php -r '$f=$argv[1]; $t=json_decode(file_get_contents($f),true); unset($t["generatedData"]); file_put_contents($f, json_encode($t, JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE));' "$dest/theme.json"; \
    chown -R www-data:www-data app/themes

# Bake the Publisher bootstrap/seed entrypoints so the image is self-contained
# (no host bind mounts): the publisher-bootstrap, publisher-content-list-seed,
# and hasura-bootstrap RunTask one-shots — and the local bootstrap compose
# services — run these baked copies. content-lists.sh is sourced by the other two
# via $(dirname "$0"), so it sits beside them in /usr/local/bin. The Hasura
# metadata is a Publisher artifact, so it lives here too.
COPY etc/docker/bootstrap/bootstrap-publisher.sh /usr/local/bin/bootstrap-publisher.sh
COPY etc/docker/bootstrap/seed-content-lists.sh  /usr/local/bin/seed-content-lists.sh
COPY etc/docker/bootstrap/content-lists.sh       /usr/local/bin/content-lists.sh
COPY etc/docker/bootstrap/bootstrap-hasura.sh    /usr/local/bin/bootstrap-hasura.sh
RUN chmod +x /usr/local/bin/bootstrap-publisher.sh /usr/local/bin/seed-content-lists.sh /usr/local/bin/bootstrap-hasura.sh
COPY etc/docker/bootstrap/hasura_metadata.json   /usr/local/share/hasura/hasura_metadata.json

CMD ["php-fpm"]
